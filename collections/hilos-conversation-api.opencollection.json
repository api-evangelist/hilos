{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hilos Contact Conversation API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversation",
        "type": "folder"
      },
      "items": [
